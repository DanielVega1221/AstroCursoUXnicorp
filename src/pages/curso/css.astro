---
import CourseLayout from '../../layouts/CourseLayout.astro';
import CodeBlock from '../../components/CodeBlock';
import FlexboxDemo from '../../components/FlexboxDemo';
import GridDemo from '../../components/GridDemo';
import { Palette, Smartphone, Sparkles } from 'lucide-react';
---

<CourseLayout title="CSS + Responsive | UXnicorp Academy">
  <div class="prose-custom max-w-4xl">
    <div class="mb-12 animate-slide-up">
      <div class="flex items-center space-x-3 mb-4">
        <div class="w-12 h-12 rounded-xl bg-primary-500/10 flex items-center justify-center">
          <Palette className="w-6 h-6 text-primary-600 dark:text-primary-400" />
        </div>
        <div>
          <p class="text-sm text-primary-600 dark:text-primary-400 font-medium">Módulo 3</p>
          <h1 class="text-4xl font-bold m-0">CSS + Responsive + Diseño Moderno</h1>
        </div>
      </div>
      <p class="text-xl text-[rgb(var(--color-text-secondary))]">
        Domina el arte de dar estilo a la web con CSS moderno, Flexbox, Grid, responsive design y animaciones.
      </p>
    </div>

    <!-- Introducción CSS -->
    <section class="mb-16">
      <h2>¿Qué es CSS?</h2>
      
      <div class="card bg-gradient-to-br from-primary-500/5 to-purple-500/5">
        <p>
          <strong>CSS</strong> (Cascading Style Sheets) es el lenguaje que da estilo visual a las páginas web.
          Controla colores, tamaños, posiciones, animaciones y mucho más.
        </p>
      </div>

      <h3>Formas de Usar CSS</h3>
      
      <p>Hay <strong>3 formas</strong> de aplicar CSS. La mejor práctica es usar <strong>CSS externo</strong> (archivo .css separado).</p>
      
      <div class="grid md:grid-cols-3 gap-4 mb-4">
        <div class="card bg-red-50 dark:bg-red-900/20">
          <h4 class="text-sm font-semibold text-red-600">1. Inline</h4>
          <p class="text-xs mt-2">En el HTML directamente</p>
          <p class="text-xs text-red-600">❌ No recomendado</p>
        </div>
        <div class="card bg-yellow-50 dark:bg-yellow-900/20">
          <h4 class="text-sm font-semibold text-yellow-600">2. Interno</h4>
          <p class="text-xs mt-2">En etiqueta &lt;style&gt;</p>
          <p class="text-xs text-yellow-600">⚠️ Solo para demos</p>
        </div>
        <div class="card bg-green-50 dark:bg-green-900/20">
          <h4 class="text-sm font-semibold text-green-600">3. Externo</h4>
          <p class="text-xs mt-2">Archivo .css separado</p>
          <p class="text-xs text-green-600">✅ RECOMENDADO</p>
        </div>
      </div>
      
      <CodeBlock 
        client:load
        language="css"
        filename="formas-css.html"
        code={`<!-- 1. CSS Inline (no recomendado) -->
<p style="color: blue; font-size: 18px;">Texto azul</p>

<!-- 2. CSS Interno (en el mismo HTML) -->
<style>
  p {
    color: blue;
    font-size: 18px;
  }
</style>

<!-- 3. CSS Externo (recomendado) -->
<link rel="stylesheet" href="styles.css">`}
      />

      <h3>Sintaxis Básica</h3>
      
      <p>CSS usa una estructura simple: <strong>selector</strong> (qué elemento) + <strong>declaraciones</strong> (cómo se ve).</p>
      
      <div class="card bg-gradient-to-r from-primary-50 to-primary-100 dark:from-primary-900/20 dark:to-primary-800/20 mb-4">
        <p class="font-semibold mb-3">Anatomía de una regla CSS:</p>
        <div class="bg-white dark:bg-slate-800 p-4 rounded font-mono text-sm">
          <span class="text-primary-600 font-bold">selector</span> {'{'}
          <br />&nbsp;&nbsp;<span class="text-green-600">propiedad</span>: <span class="text-purple-600">valor</span>;
          <br />&nbsp;&nbsp;<span class="text-green-600">otra-propiedad</span>: <span class="text-purple-600">otro-valor</span>;
          <br />{'}'}
        </div>
      </div>
      
      <CodeBlock 
        client:load
        language="css"
        filename="sintaxis.css"
        code={`/* Selector: elige qué elementos estilizar */
selector {
  propiedad: valor;
  otra-propiedad: otro-valor;
}

/* Ejemplos */
h1 {
  color: #2563eb;
  font-size: 32px;
  font-weight: bold;
}

.clase {
  background-color: #f3f4f6;
  padding: 20px;
}

#id-unico {
  border: 2px solid black;
}`}
      />
    </section>

    <!-- Selectores -->
    <section class="mb-16">
      <h2>Selectores CSS</h2>

      <div class="grid md:grid-cols-2 gap-4">
        <div class="card">
          <h4 class="font-semibold text-primary-600 dark:text-primary-400">Selector de Etiqueta</h4>
          <code class="text-sm">p {'{ }'}</code>
          <p class="text-sm mt-2">Selecciona todas las etiquetas <code>&lt;p&gt;</code></p>
        </div>

        <div class="card">
          <h4 class="font-semibold text-primary-600 dark:text-primary-400">Selector de Clase</h4>
          <code class="text-sm">.nombre {'{ }'}</code>
          <p class="text-sm mt-2">Selecciona elementos con <code>class="nombre"</code></p>
        </div>

        <div class="card">
          <h4 class="font-semibold text-primary-600 dark:text-primary-400">Selector de ID</h4>
          <code class="text-sm">#id {'{ }'}</code>
          <p class="text-sm mt-2">Selecciona el elemento con <code>id="id"</code></p>
        </div>

        <div class="card">
          <h4 class="font-semibold text-primary-600 dark:text-primary-400">Selector Universal</h4>
          <code class="text-sm">* {'{ }'}</code>
          <p class="text-sm mt-2">Selecciona TODOS los elementos</p>
        </div>
      </div>

      <CodeBlock 
        client:load
        language="css"
        filename="selectores-avanzados.css"
        code={`/* Descendiente */
div p {
  /* Todos los <p> dentro de un <div> */
}

/* Hijo directo */
div > p {
  /* Solo <p> que son hijos directos de <div> */
}

/* Hermano adyacente */
h2 + p {
  /* El <p> inmediatamente después de un <h2> */
}

/* Pseudo-clases */
a:hover {
  /* Cuando pasas el mouse sobre un enlace */
}

button:active {
  /* Mientras haces clic en un botón */
}

input:focus {
  /* Cuando un input está seleccionado */
}

li:first-child {
  /* El primer elemento de una lista */
}

/* Pseudo-elementos */
p::before {
  content: "→ ";
}

p::after {
  content: " ←";
}`}
      />
    </section>

    <!-- Flexbox -->
    <section class="mb-16">
      <h2 class="flex items-center space-x-3">
        <Sparkles className="w-8 h-8 text-primary-600 dark:text-primary-400" />
        <span>Flexbox: Layout en Una Dimensión</span>
      </h2>

      <div class="card bg-gradient-to-br from-purple-500/5 to-pink-500/5">
        <p>
          <strong>Flexbox</strong> es perfecto para alinear elementos en <strong>una dirección</strong> (fila o columna).
          Ideal para navbars, cards horizontales, centrado de elementos...
        </p>
      </div>
      
      <div class="card bg-primary-50 dark:bg-primary-900/20 mb-6">
        <h4 class="font-semibold mb-3">🎯 Cuándo usar Flexbox:</h4>
        <ul class="text-sm space-y-1">
          <li>✓ Barra de navegación horizontal</li>
          <li>✓ Centrar elementos vertical u horizontalmente</li>
          <li>✓ Distribuir espacio entre botones</li>
          <li>✓ Cards en fila que se adaptan</li>
          <li>✓ Footer con elementos espaciados</li>
        </ul>
      </div>

      <h3>Demo Interactiva de Flexbox</h3>
      
      <FlexboxDemo client:load />

      <h3>Propiedades Principales</h3>
      
      <p>Flexbox tiene dos tipos de elementos: el <strong>contenedor</strong> (padre con <code>display: flex</code>) y los <strong>items</strong> (hijos directos).</p>
      
      <div class="grid md:grid-cols-2 gap-4 mb-4">
        <div class="card bg-purple-50 dark:bg-purple-900/20">
          <h4 class="text-sm font-semibold text-purple-600 mb-2">Contenedor (Padre)</h4>
          <ul class="text-xs space-y-1">
            <li>• <code>flex-direction</code> - Dirección</li>
            <li>• <code>justify-content</code> - Eje principal</li>
            <li>• <code>align-items</code> - Eje cruzado</li>
            <li>• <code>gap</code> - Espaciado</li>
          </ul>
        </div>
        <div class="card bg-pink-50 dark:bg-pink-900/20">
          <h4 class="text-sm font-semibold text-pink-600 mb-2">Items (Hijos)</h4>
          <ul class="text-xs space-y-1">
            <li>• <code>flex-grow</code> - Crecer</li>
            <li>• <code>flex-shrink</code> - Encoger</li>
            <li>• <code>flex-basis</code> - Tamaño base</li>
            <li>• <code>flex</code> - Shorthand</li>
          </ul>
        </div>
      </div>
      
      <CodeBlock 
        client:load
        language="css"
        filename="flexbox.css"
        code={`/* Contenedor Flex */
.container {
  display: flex;
  
  /* Dirección */
  flex-direction: row; /* row | column | row-reverse | column-reverse */
  
  /* Alineación horizontal (en row) */
  justify-content: center; /* flex-start | center | flex-end | space-between | space-around */
  
  /* Alineación vertical (en row) */
  align-items: center; /* flex-start | center | flex-end | stretch */
  
  /* Espaciado entre elementos */
  gap: 16px;
  
  /* Envolver elementos */
  flex-wrap: wrap; /* nowrap | wrap */
}

/* Items Flex */
.item {
  /* Crecer para llenar espacio */
  flex-grow: 1;
  
  /* Encogerse si es necesario */
  flex-shrink: 1;
  
  /* Tamaño base */
  flex-basis: 200px;
  
  /* Shorthand */
  flex: 1 1 200px; /* grow shrink basis */
}`}
      />
    </section>

    <!-- Grid -->
    <section class="mb-16">
      <h2>CSS Grid: Layout en Dos Dimensiones</h2>

      <div class="card bg-gradient-to-br from-primary-500/5 to-primary-600/5">
        <p>
          <strong>CSS Grid</strong> es ideal para layouts complejos en <strong>filas Y columnas</strong> simultáneamente.
          Perfecto para galerías, dashboards, layouts completos...
        </p>
      </div>
      
      <div class="card bg-green-50 dark:bg-green-900/20 mb-6">
        <h4 class="font-semibold mb-3">🎯 Cuándo usar Grid:</h4>
        <ul class="text-sm space-y-1">
          <li>✓ Galerías de imágenes</li>
          <li>✓ Layouts completos (header, sidebar, content, footer)</li>
          <li>✓ Dashboards con widgets</li>
          <li>✓ Tablas complejas de contenido</li>
          <li>✓ Cualquier diseño bidimensional</li>
        </ul>
      </div>
      
      <div class="card bg-gradient-to-r from-primary-50 to-primary-100 dark:from-primary-900/20 dark:to-primary-800/20 mb-6">
        <p class="font-semibold mb-3">💡 Diferencia clave:</p>
        <div class="grid md:grid-cols-2 gap-4 text-sm">
          <div>
            <p class="font-semibold text-purple-600">Flexbox</p>
            <p>Una dimensión (fila O columna)</p>
            <div class="mt-2 flex gap-2">
              <div class="w-12 h-12 bg-purple-400 rounded"></div>
              <div class="w-12 h-12 bg-purple-400 rounded"></div>
              <div class="w-12 h-12 bg-purple-400 rounded"></div>
            </div>
          </div>
          <div>
            <p class="font-semibold text-green-600">Grid</p>
            <p>Dos dimensiones (filas Y columnas)</p>
            <div class="mt-2 grid grid-cols-3 gap-2">
              <div class="w-12 h-12 bg-green-400 rounded"></div>
              <div class="w-12 h-12 bg-green-400 rounded"></div>
              <div class="w-12 h-12 bg-green-400 rounded"></div>
              <div class="w-12 h-12 bg-green-400 rounded"></div>
              <div class="w-12 h-12 bg-green-400 rounded"></div>
              <div class="w-12 h-12 bg-green-400 rounded"></div>
            </div>
          </div>
        </div>
      </div>

      <h3>Demo Interactiva de Grid</h3>
      
      <GridDemo client:load />
      
      <h3>Propiedades Principales</h3>
      
      <p>Grid divide el espacio en <strong>filas y columnas</strong>, creando una cuadrícula donde puedes colocar elementos.</p>

      <CodeBlock 
        client:load
        language="css"
        filename="grid.css"
        code={`/* Contenedor Grid */
.container {
  display: grid;
  
  /* Definir columnas */
  grid-template-columns: 1fr 2fr 1fr; /* 3 columnas */
  grid-template-columns: repeat(3, 1fr); /* 3 columnas iguales */
  grid-template-columns: 200px auto 200px; /* tamaños mixtos */
  
  /* Definir filas */
  grid-template-rows: 100px 200px auto;
  
  /* Espaciado */
  gap: 20px; /* espacio entre celdas */
  row-gap: 10px;
  column-gap: 20px;
}

/* Items Grid */
.item {
  /* Ocupar múltiples columnas */
  grid-column: span 2; /* ocupa 2 columnas */
  grid-column: 1 / 3; /* de columna 1 a 3 */
  
  /* Ocupar múltiples filas */
  grid-row: span 2;
}

/* Grid Areas (nombrado) */
.container {
  grid-template-areas:
    "header header header"
    "sidebar main main"
    "footer footer footer";
}

.header { grid-area: header; }
.sidebar { grid-area: sidebar; }
.main { grid-area: main; }
.footer { grid-area: footer; }`}
      />
    </section>

    <!-- Responsive Design -->
    <section class="mb-16">
      <h2 class="flex items-center space-x-3">
        <Smartphone className="w-8 h-8 text-primary-600 dark:text-primary-400" />
        <span>Responsive Design</span>
      </h2>

      <div class="card bg-gradient-to-br from-orange-500/5 to-red-500/5">
        <p>
          <strong>Responsive Design</strong> significa que tu sitio se adapta a cualquier tamaño de pantalla:
          móvil, tablet, desktop...
        </p>
      </div>

      <h3>Media Queries</h3>
      
      <CodeBlock 
        client:load
        language="css"
        filename="responsive.css"
        code={`/* Mobile First: estilos base para móvil */
.container {
  padding: 16px;
  font-size: 14px;
}

/* Tablet: 768px en adelante */
@media (min-width: 768px) {
  .container {
    padding: 24px;
    font-size: 16px;
  }
}

/* Desktop: 1024px en adelante */
@media (min-width: 1024px) {
  .container {
    padding: 32px;
    font-size: 18px;
    max-width: 1200px;
    margin: 0 auto;
  }
}

/* Orientación */
@media (orientation: landscape) {
  /* Estilos para vista horizontal */
}

/* Dark mode */
@media (prefers-color-scheme: dark) {
  body {
    background: #1a1a1a;
    color: #ffffff;
  }
}`}
      />

      <h3>Técnicas Responsive Modernas</h3>
      
      <CodeBlock 
        client:load
        language="css"
        filename="responsive-moderno.css"
        code={`/* Clamp: tamaño fluido */
.title {
  font-size: clamp(24px, 5vw, 48px);
  /* min, preferido, max */
}

/* Container Queries (nuevo!) */
@container (min-width: 600px) {
  .card {
    display: grid;
    grid-template-columns: 1fr 2fr;
  }
}

/* Grid responsive automático */
.gallery {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 20px;
}

/* Unidades relativas */
.box {
  width: 50vw; /* 50% del viewport width */
  height: 50vh; /* 50% del viewport height */
  padding: 2rem; /* relativo al font-size raíz */
}`}
      />
    </section>

    <!-- Variables CSS -->
    <section class="mb-16">
      <h2>Variables CSS (Custom Properties)</h2>

      <CodeBlock 
        client:load
        language="css"
        filename="variables.css"
        code={`:root {
  /* Definir variables */
  --primary-color: #2563eb;
  --secondary-color: #7c3aed;
  --spacing-unit: 8px;
  --font-size-base: 16px;
}

/* Usar variables */
.button {
  background-color: var(--primary-color);
  padding: calc(var(--spacing-unit) * 2);
  font-size: var(--font-size-base);
}

/* Dark mode con variables */
.dark {
  --primary-color: #60a5fa;
  --bg-color: #1a1a1a;
  --text-color: #ffffff;
}

body {
  background-color: var(--bg-color);
  color: var(--text-color);
}`}
      />
    </section>

    <!-- Animaciones -->
    <section class="mb-16">
      <h2>Animaciones y Transiciones</h2>

      <h3>Transiciones</h3>
      
      <CodeBlock 
        client:load
        language="css"
        filename="transiciones.css"
        code={`.button {
  background: #2563eb;
  transform: scale(1);
  
  /* Transición suave */
  transition: all 0.3s ease;
}

.button:hover {
  background: #1d4ed8;
  transform: scale(1.05);
}

/* Transiciones específicas */
.card {
  transition: 
    transform 0.3s ease,
    box-shadow 0.3s ease;
}

.card:hover {
  transform: translateY(-4px);
  box-shadow: 0 10px 30px rgba(0,0,0,0.2);
}`}
      />

      <h3>Animaciones con @keyframes</h3>
      
      <CodeBlock 
        client:load
        language="css"
        filename="animaciones.css"
        code={`/* Definir animación */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Aplicar animación */
.element {
  animation: fadeIn 0.5s ease-out;
}

/* Animación con pasos */
@keyframes pulse {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.1);
  }
}

.icon {
  animation: pulse 2s infinite;
}`}
      />
    </section>

    <!-- CSS Cheat Sheet -->
    <section class="mb-16">
      <h2 class="flex items-center space-x-3">
        <span class="text-2xl">🎨</span>
        <span>CSS Cheat Sheet</span>
      </h2>
      
      <div class="card">
        <div class="space-y-4">
          <div class="grid md:grid-cols-2 gap-4">
            <div>
              <h4 class="font-semibold text-primary-600 mb-2">Selectores</h4>
              <div class="bg-gray-50 dark:bg-gray-800 p-3 rounded text-xs space-y-1">
                <p><code>elemento {'{}'}</code> - Por etiqueta</p>
                <p><code>.clase {'{}'}</code> - Por clase</p>
                <p><code>#id {'{}'}</code> - Por ID</p>
                <p><code>* {'{}'}</code> - Universal</p>
                <p><code>padre hijo {'{}'}</code> - Descendiente</p>
                <p><code>elemento:hover {'{}'}</code> - Pseudo-clase</p>
              </div>
            </div>

            <div>
              <h4 class="font-semibold text-blue-600 mb-2">Colores</h4>
              <div class="bg-gray-50 dark:bg-gray-800 p-3 rounded text-xs space-y-1">
                <p><code>color: red;</code></p>
                <p><code>color: #ff0000;</code> - Hexadecimal</p>
                <p><code>color: rgb(255, 0, 0);</code></p>
                <p><code>color: rgba(255, 0, 0, 0.5);</code></p>
                <p><code>background-color: blue;</code></p>
              </div>
            </div>

            <div>
              <h4 class="font-semibold text-blue-600 mb-2">Texto</h4>
              <div class="bg-gray-50 dark:bg-gray-800 p-3 rounded text-xs space-y-1">
                <p><code>font-size: 16px;</code></p>
                <p><code>font-family: Arial, sans-serif;</code></p>
                <p><code>font-weight: bold;</code> (400-900)</p>
                <p><code>text-align: center;</code></p>
                <p><code>line-height: 1.5;</code></p>
                <p><code>text-decoration: underline;</code></p>
              </div>
            </div>

            <div>
              <h4 class="font-semibold text-blue-600 mb-2">Box Model</h4>
              <div class="bg-gray-50 dark:bg-gray-800 p-3 rounded text-xs space-y-1">
                <p><code>width: 200px;</code></p>
                <p><code>height: 100px;</code></p>
                <p><code>margin: 10px;</code> - Exterior</p>
                <p><code>padding: 10px;</code> - Interior</p>
                <p><code>border: 1px solid black;</code></p>
                <p><code>box-sizing: border-box;</code></p>
              </div>
            </div>
          </div>

          <div>
            <h4 class="font-semibold text-blue-600 mb-2">Flexbox (1D)</h4>
            <div class="bg-gray-50 dark:bg-gray-800 p-3 rounded text-xs">
              <div class="grid md:grid-cols-2 gap-3">
                <div>
                  <p class="font-semibold mb-1">Contenedor:</p>
                  <p><code>display: flex;</code></p>
                  <p><code>flex-direction: row | column;</code></p>
                  <p><code>justify-content: center;</code></p>
                  <p><code>align-items: center;</code></p>
                  <p><code>gap: 10px;</code></p>
                </div>
                <div>
                  <p class="font-semibold mb-1">Items:</p>
                  <p><code>flex: 1;</code> - Crecer</p>
                  <p><code>flex-shrink: 0;</code> - No encoger</p>
                  <p><code>order: 1;</code> - Orden</p>
                </div>
              </div>
            </div>
          </div>

          <div>
            <h4 class="font-semibold text-blue-600 mb-2">Grid (2D)</h4>
            <div class="bg-gray-50 dark:bg-gray-800 p-3 rounded text-xs">
              <div class="grid md:grid-cols-2 gap-3">
                <div>
                  <p class="font-semibold mb-1">Contenedor:</p>
                  <p><code>display: grid;</code></p>
                  <p><code>grid-template-columns: 1fr 1fr 1fr;</code></p>
                  <p><code>grid-template-rows: auto;</code></p>
                  <p><code>gap: 20px;</code></p>
                </div>
                <div>
                  <p class="font-semibold mb-1">Items:</p>
                  <p><code>grid-column: 1 / 3;</code></p>
                  <p><code>grid-row: 1 / 2;</code></p>
                </div>
              </div>
            </div>
          </div>

          <div>
            <h4 class="font-semibold text-blue-600 mb-2">Responsive</h4>
            <div class="bg-gray-50 dark:bg-gray-800 p-3 rounded text-xs space-y-2">
              <pre>{"@media (max-width: 768px) { /* Móvil */ }"}</pre>
              <pre>{"@media (min-width: 769px) { /* Desktop */ }"}</pre>
            </div>
          </div>

          <div class="grid md:grid-cols-2 gap-4">
            <div>
              <h4 class="font-semibold text-blue-600 mb-2">Posicionamiento</h4>
              <div class="bg-gray-50 dark:bg-gray-800 p-3 rounded text-xs space-y-1">
                <p><code>position: static;</code> - Normal</p>
                <p><code>position: relative;</code> - Relativo</p>
                <p><code>position: absolute;</code> - Absoluto</p>
                <p><code>position: fixed;</code> - Fijo</p>
                <p><code>position: sticky;</code> - Pegajoso</p>
                <p><code>top, right, bottom, left: 0;</code></p>
                <p><code>z-index: 10;</code></p>
              </div>
            </div>

            <div>
              <h4 class="font-semibold text-blue-600 mb-2">Transiciones</h4>
              <div class="bg-gray-50 dark:bg-gray-800 p-3 rounded text-xs space-y-1">
                <p><code>transition: all 0.3s ease;</code></p>
                <p><code>transform: scale(1.1);</code></p>
                <p><code>transform: rotate(45deg);</code></p>
                <p><code>opacity: 0.5;</code></p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

