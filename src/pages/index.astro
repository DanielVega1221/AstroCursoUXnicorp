---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ArrowRight, Book, Code, Award, Heart, Target, Layers, Compass, Star } from 'lucide-react';

const roadmapSteps = [
  { title: 'Fundamentos', desc: 'Conceptos básicos de programación y web', modules: '1 módulo', icon: Compass },
  { title: 'Lenguajes Base', desc: 'HTML, CSS y JavaScript desde cero', modules: '4 módulos', icon: Code },
  { title: 'Framework Moderno', desc: 'Astro, React Islands y TypeScript', modules: '3 módulos', icon: Layers },
  { title: 'Proyecto Integrador', desc: 'Crea un proyecto completo de cero a deploy', modules: '1 módulo', icon: Sparkles },
  { title: 'Profesionalización', desc: 'Performance, SEO y metodologías', modules: '2 módulos', icon: Target },
  { title: 'Práctica', desc: 'Ejercicios y proyecto final', modules: '3 módulos', icon: Star },
];
---

<BaseLayout>
  <div class="min-h-screen">
    <!-- Hero Section -->
    <section class="relative overflow-hidden bg-gradient-to-br from-primary-50 via-white to-primary-100 dark:from-slate-900 dark:via-slate-900 dark:to-slate-800">
      <!-- Decorative blobs -->
      <div class="absolute top-20 right-10 w-72 h-72 bg-primary-200/40 dark:bg-primary-500/10 rounded-full blur-3xl"></div>
      <div class="absolute bottom-20 left-10 w-96 h-96 bg-primary-300/30 dark:bg-primary-600/10 rounded-full blur-3xl"></div>
      
      <div class="container-custom relative z-10">
        <div class="py-24 md:py-40">
          <div class="max-w-5xl mx-auto text-center space-y-10 animate-fade-in">
            <!-- Badge -->
            <div class="inline-flex items-center space-x-2 px-5 py-2.5 rounded-full bg-gradient-to-r from-primary-100 to-primary-200 dark:from-primary-900/30 dark:to-primary-800/30 border border-primary-200/50 dark:border-primary-500/20 backdrop-blur-sm">
              
              <span class="text-sm font-medium text-primary-700 dark:text-primary-300">
                Curso Completo
              </span>
            </div>

            <!-- Main Title -->
            <h1 class="text-6xl md:text-8xl font-bold leading-tight tracking-tight">
              <span class="block text-slate-900 dark:text-white mb-2">Desarrollo Web</span>
              <span class="block bg-gradient-to-r from-primary-500 via-primary-600 to-primary-500 bg-clip-text text-transparent">
                de Cero a Experto
              </span>
            </h1>

            <!-- Subtitle -->
            <p class="text-xl md:text-2xl text-slate-600 dark:text-slate-300 max-w-3xl mx-auto leading-relaxed font-light">
              Aprende desarrollo web moderno con un enfoque práctico y chill. 
              HTML, CSS, JavaScript, Astro y más, diseñado con el estilo UXnicorp.
            </p>

            <!-- CTA Buttons -->
            <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-6">
              <a href="/curso/fundamentos" class="group btn-pink text-lg px-10 py-5 flex items-center space-x-3 shadow-lg shadow-primary-500/20 hover:shadow-xl hover:shadow-primary-500/30">
                <span>Empezar Ahora</span>
                <ArrowRight className="w-5 h-5 group-hover:translate-x-1 transition-transform" />
              </a>
              <a href="/recursos" class="btn-ghost text-lg px-10 py-5">
                Ver Recursos
              </a>
            </div>

            <!-- Badge Gratuito & Mensaje Motivacional -->
            <div class="flex flex-col items-center gap-6 pt-16">
              <div class="inline-flex items-center space-x-2 px-6 py-3 rounded-full bg-gradient-to-r from-green-100 to-emerald-100 dark:from-green-900/30 dark:to-emerald-900/30 border-2 border-green-200 dark:border-green-500/30">
                <Heart className="w-5 h-5 text-green-600 dark:text-green-400" />
                <span class="text-lg font-semibold text-green-700 dark:text-green-300">
                  100% Gratuito
                </span>
              </div>
              
              <p class="text-lg md:text-xl text-slate-600 dark:text-slate-300 max-w-2xl mx-auto font-medium italic">
                "Cualquiera puede convertirse en un gran programador si se lo propone. 
                <span class="text-primary-600 dark:text-primary-400">Solo necesitas dedicación y las herramientas correctas.</span>"
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Features -->
    <section class="py-24 bg-white dark:bg-slate-900">
      <div class="container-custom">
        <div class="text-center mb-16 space-y-4">
          <h2 class="text-4xl md:text-5xl font-bold text-slate-900 dark:text-white">
            ¿Qué aprenderás?
          </h2>
          <p class="text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto">
            Un curso completo diseñado con amor y dedicación
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          <!-- Feature 1 -->
          <div class="group card-soft hover:translate-y-[-4px] transition-all duration-300">
            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-primary-100 to-primary-200 dark:from-primary-900/30 dark:to-primary-800/30 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform">
              <Book className="w-7 h-7 text-primary-600 dark:text-primary-400" />
            </div>
            <h3 class="text-xl font-semibold mb-3 text-slate-900 dark:text-white">Fundamentos Sólidos</h3>
            <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
              Desde conceptos básicos hasta arquitecturas avanzadas, explicado de forma clara.
            </p>
          </div>

          <!-- Feature 2 -->
          <div class="group card-soft hover:translate-y-[-4px] transition-all duration-300">
            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-primary-100 to-primary-200 dark:from-primary-900/30 dark:to-primary-800/30 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform">
              <Code className="w-7 h-7 text-primary-600 dark:text-primary-400" />
            </div>
            <h3 class="text-xl font-semibold mb-3 text-slate-900 dark:text-white">Ejemplos Interactivos</h3>
            <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
              Demos en vivo y ejercicios prácticos para aprender haciendo.
            </p>
          </div>

          <!-- Feature 3 -->
          <div class="group card-soft hover:translate-y-[-4px] transition-all duration-300">
            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-primary-100 to-primary-200 dark:from-primary-900/30 dark:to-primary-800/30 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform">
              <Layers className="w-7 h-7 text-primary-600 dark:text-primary-400" />
            </div>
            <h3 class="text-xl font-semibold mb-3 text-slate-900 dark:text-white">Astro Framework</h3>
            <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
              Domina el framework más rápido y moderno del mercado.
            </p>
          </div>

          <!-- Feature 4 -->
          <div class="group card-soft hover:translate-y-[-4px] transition-all duration-300">
            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-primary-100 to-primary-200 dark:from-primary-900/30 dark:to-primary-800/30 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform">
              <Sparkles className="w-7 h-7 text-primary-600 dark:text-primary-400" />
            </div>
            <h3 class="text-xl font-semibold mb-3 text-slate-900 dark:text-white">Performance & SEO</h3>
            <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
              Crea sitios ultra rápidos y optimizados para buscadores.
            </p>
          </div>

          <!-- Feature 5 -->
          <div class="group card-soft hover:translate-y-[-4px] transition-all duration-300">
            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-primary-100 to-primary-200 dark:from-primary-900/30 dark:to-primary-800/30 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform">
              <Award className="w-7 h-7 text-primary-600 dark:text-primary-400" />
            </div>
            <h3 class="text-xl font-semibold mb-3 text-slate-900 dark:text-white">Proyecto Final</h3>
            <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
              Construye un portfolio premium para tu carrera profesional.
            </p>
          </div>

          <!-- Feature 6 -->
          <div class="group card-soft hover:translate-y-[-4px] transition-all duration-300">
            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-primary-100 to-primary-200 dark:from-primary-900/30 dark:to-primary-800/30 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform">
              <Heart className="w-7 h-7 text-primary-600 dark:text-primary-400" />
            </div>
            <h3 class="text-xl font-semibold mb-3 text-slate-900 dark:text-white">Estilo UXnicorp</h3>
            <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
              Diseñado con la calidad y estética chill de nuestro equipo.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Learning Path -->
    <section class="py-24 bg-gradient-to-b from-primary-50/30 to-white dark:from-slate-900 dark:to-slate-900 relative overflow-hidden">
      {/* Decorative elements */}
      <div class="absolute top-10 left-10 w-64 h-64 bg-primary-200/20 dark:bg-primary-500/5 rounded-full blur-3xl"></div>
      <div class="absolute bottom-10 right-10 w-80 h-80 bg-primary-300/20 dark:bg-primary-600/5 rounded-full blur-3xl"></div>
      
      <div class="container-custom relative z-10">
        <div class="text-center mb-16 space-y-4">
          <h2 class="text-4xl md:text-5xl font-bold text-slate-900 dark:text-white">
            Tu Ruta de Aprendizaje
          </h2>
          <p class="text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto">
            Un camino estructurado para llevarte de principiante a profesional
          </p>
        </div>

        <div class="max-w-3xl mx-auto space-y-5">
          {roadmapSteps.map((step, index) => {
            const Icon = step.icon;
            return (
              <div class="group bg-white/80 dark:bg-slate-800/50 backdrop-blur-sm border border-slate-200/50 dark:border-slate-700/50 rounded-2xl p-7 shadow-sm hover:shadow-xl hover:border-primary-300 dark:hover:border-primary-600 transition-all duration-300 cursor-pointer hover:translate-x-2 relative overflow-hidden">
                {/* Gradient overlay on hover */}
                <div class="absolute inset-0 bg-gradient-to-r from-primary-500/0 via-primary-500/5 to-primary-500/0 opacity-0 group-hover:opacity-100 transition-opacity duration-500" />
                
                <div class="relative z-10 flex items-start space-x-5">
                  {/* Number badge */}
                  <div class="flex-shrink-0 w-14 h-14 rounded-xl bg-gradient-to-br from-primary-500 to-primary-600 text-white flex items-center justify-center font-bold text-xl shadow-lg shadow-primary-500/25 group-hover:shadow-primary-500/50 transition-all group-hover:rotate-12">
                    {index + 1}
                  </div>
                  
                  {/* Content */}
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-3 mb-2">
                      <h3 class="text-xl font-semibold text-slate-900 dark:text-white group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
                        {step.title}
                      </h3>
                      <Icon className="w-5 h-5 text-primary-500 dark:text-primary-400" />
                    </div>
                    <p class="text-slate-600 dark:text-slate-400 mb-3 leading-relaxed">
                      {step.desc}
                    </p>
                    <span class="inline-flex items-center text-sm font-medium text-primary-600 dark:text-primary-400 group-hover:translate-x-1 transition-transform">
                      {step.modules} →
                    </span>
                  </div>
                </div>

                {/* Decorative corner accent */}
                <div class="absolute top-0 right-0 w-20 h-20 bg-gradient-to-bl from-primary-500/10 to-transparent rounded-bl-full opacity-0 group-hover:opacity-100 transition-opacity duration-500" />
                
                {/* Connecting line (except for last item) */}
                {index < roadmapSteps.length - 1 && (
                  <div class="absolute left-7 -bottom-5 w-0.5 h-5 bg-gradient-to-b from-primary-400 to-primary-300 dark:from-primary-600 dark:to-primary-500" />
                )}
              </div>
            );
          })}
        </div>

        <div class="text-center mt-16">
          <a href="/curso/fundamentos" class="group btn-pink text-lg px-10 py-5 inline-flex items-center space-x-3 shadow-lg shadow-primary-500/20 hover:shadow-xl hover:shadow-primary-500/30">
            <span>Comenzar el Curso</span>
            <ArrowRight className="w-5 h-5 group-hover:translate-x-1 transition-transform" />
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .btn-pink {
    @apply bg-gradient-to-r from-primary-500 to-primary-600 text-white px-6 py-3 rounded-xl font-semibold transition-all duration-300 hover:scale-105 active:scale-95;
  }

  .btn-ghost {
    @apply bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 px-6 py-3 rounded-xl font-semibold border-2 border-slate-200 dark:border-slate-700 transition-all duration-300 hover:border-primary-300 dark:hover:border-primary-700 hover:scale-105 active:scale-95;
  }

  .card-soft {
    @apply bg-white/80 dark:bg-slate-800/50 backdrop-blur-sm border border-slate-200/50 dark:border-slate-700/50 rounded-2xl p-7 shadow-sm hover:shadow-md transition-all duration-300;
  }
</style>
