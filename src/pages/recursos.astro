---
import CourseLayout from '../layouts/CourseLayout.astro';
import { Briefcase, BookOpen, Palette, Code, Star, ExternalLink } from 'lucide-react';
---

<CourseLayout title="Recursos y Carrera | UXnicorp Academy">
  <div class="prose-custom max-w-4xl">
    <div class="mb-12 animate-slide-up">
      <div class="flex items-center space-x-3 mb-4">
        <div class="w-12 h-12 rounded-xl bg-purple-500/10 flex items-center justify-center">
          <Briefcase className="w-6 h-6 text-purple-600 dark:text-purple-400" />
        </div>
        <div>
          <h1 class="text-4xl font-bold m-0">Recursos y Profesionalización</h1>
        </div>
      </div>
      <p class="text-xl text-[rgb(var(--color-text-secondary))]">
        Todo lo que necesitas para impulsar tu carrera: portfolios de inspiración, recursos gratuitos y consejos profesionales.
      </p>
    </div>

    <!-- Portfolios Inspiración -->
    <section class="mb-16">
      <h2 class="flex items-center space-x-3">
        <Star className="w-8 h-8 text-yellow-600 dark:text-yellow-400" />
        <span>Portfolios de Inspiración</span>
      </h2>

      <div class="grid md:grid-cols-2 gap-6">
        <a href="https://bruno-simon.com" target="_blank" class="card hover:scale-105 transition-all group">
          <div class="flex items-start justify-between mb-3">
            <h3 class="text-lg font-semibold group-hover:text-primary-600">Bruno Simon</h3>
            <ExternalLink className="w-5 h-5 text-[rgb(var(--color-text-secondary))]" />
          </div>
          <p class="text-sm text-[rgb(var(--color-text-secondary))]">
            Portfolio 3D interactivo con Three.js. Experiencia inmersiva y creativa.
          </p>
          <div class="flex flex-wrap gap-2 mt-3">
            <span class="text-xs px-2 py-1 rounded bg-primary-500/10 text-primary-600">Three.js</span>
            <span class="text-xs px-2 py-1 rounded bg-purple-500/10 text-purple-600">Innovador</span>
          </div>
        </a>

        <a href="https://www.adhamdannaway.com" target="_blank" class="card hover:scale-105 transition-all group">
          <div class="flex items-start justify-between mb-3">
            <h3 class="text-lg font-semibold group-hover:text-primary-600">Adham Dannaway</h3>
            <ExternalLink className="w-5 h-5 text-[rgb(var(--color-text-secondary))]" />
          </div>
          <p class="text-sm text-[rgb(var(--color-text-secondary))]">
            Portfolio limpio y profesional con animaciones sutiles. Perfecto para UX/UI designers.
          </p>
          <div class="flex flex-wrap gap-2 mt-3">
            <span class="text-xs px-2 py-1 rounded bg-green-500/10 text-green-600">Clean</span>
            <span class="text-xs px-2 py-1 rounded bg-primary-500/10 text-primary-600">Profesional</span>
          </div>
        </a>

        <a href="https://brittanychiang.com" target="_blank" class="card hover:scale-105 transition-all group">
          <div class="flex items-start justify-between mb-3">
            <h3 class="text-lg font-semibold group-hover:text-primary-600">Brittany Chiang</h3>
            <ExternalLink className="w-5 h-5 text-[rgb(var(--color-text-secondary))]" />
          </div>
          <p class="text-sm text-[rgb(var(--color-text-secondary))]">
            Portfolio minimalista y elegante de desarrolladora en Spotify. Diseño impecable y profesional.
          </p>
          <div class="flex flex-wrap gap-2 mt-3">
            <span class="text-xs px-2 py-1 rounded bg-purple-500/10 text-purple-600">Minimalista</span>
            <span class="text-xs px-2 py-1 rounded bg-green-500/10 text-green-600">Profesional</span>
          </div>
        </a>

        <a href="https://www.strml.net" target="_blank" class="card hover:scale-105 transition-all group">
          <div class="flex items-start justify-between mb-3">
            <h3 class="text-lg font-semibold group-hover:text-primary-600">STRML</h3>
            <ExternalLink className="w-5 h-5 text-[rgb(var(--color-text-secondary))]" />
          </div>
          <p class="text-sm text-[rgb(var(--color-text-secondary))]">
            Portfolio que se escribe a sí mismo en tiempo real. Impresionante y único.
          </p>
          <div class="flex flex-wrap gap-2 mt-3">
            <span class="text-xs px-2 py-1 rounded bg-red-500/10 text-red-600">Único</span>
            <span class="text-xs px-2 py-1 rounded bg-yellow-500/10 text-yellow-600">Interactivo</span>
          </div>
        </a>

        <a href="https://www.joshwcomeau.com" target="_blank" class="card hover:scale-105 transition-all group">
          <div class="flex items-start justify-between mb-3">
            <h3 class="text-lg font-semibold group-hover:text-primary-600">Josh W. Comeau</h3>
            <ExternalLink className="w-5 h-5 text-[rgb(var(--color-text-secondary))]" />
          </div>
          <p class="text-sm text-[rgb(var(--color-text-secondary))]">
            Blog y portfolio con animaciones deliciosas y diseño juguetón. Ex-desarrollador de Gatsby.
          </p>
          <div class="flex flex-wrap gap-2 mt-3">
            <span class="text-xs px-2 py-1 rounded bg-pink-500/10 text-pink-600">Creativo</span>
            <span class="text-xs px-2 py-1 rounded bg-yellow-500/10 text-yellow-600">Didáctico</span>
          </div>
        </a>

        <a href="https://www.dennissnellenberg.com" target="_blank" class="card hover:scale-105 transition-all group">
          <div class="flex items-start justify-between mb-3">
            <h3 class="text-lg font-semibold group-hover:text-primary-600">Dennis Snellenberg</h3>
            <ExternalLink className="w-5 h-5 text-[rgb(var(--color-text-secondary))]" />
          </div>
          <p class="text-sm text-[rgb(var(--color-text-secondary))]">
            Portfolio con smooth scroll y transiciones cinematográficas. Diseño premium y elegante.
          </p>
          <div class="flex flex-wrap gap-2 mt-3">
            <span class="text-xs px-2 py-1 rounded bg-blue-500/10 text-blue-600">Smooth Scroll</span>
            <span class="text-xs px-2 py-1 rounded bg-cyan-500/10 text-cyan-600">Premium</span>
          </div>
        </a>
      </div>
    </section>

    <!-- Librerías Útiles -->
    <section class="mb-16">
      <h2 class="flex items-center space-x-3">
        <Code className="w-8 h-8 text-primary-600 dark:text-primary-400" />
        <span>Librerías para Astro</span>
      </h2>

      <div class="space-y-6">
        <!-- Animaciones -->
        <div class="card">
          <h3 class="font-semibold text-primary-600 dark:text-primary-400 mb-3">🎬 Animaciones</h3>
          <div class="grid md:grid-cols-2 gap-4">
            <div>
              <h4 class="text-sm font-semibold mb-2">Framer Motion</h4>
              <p class="text-xs text-[rgb(var(--color-text-secondary))]">
                La mejor librería de animaciones para React. Perfecta para React Islands en Astro.
              </p>
              <code class="text-xs">npm install framer-motion</code>
            </div>
            
            <div>
              <h4 class="text-sm font-semibold mb-2">GSAP</h4>
              <p class="text-xs text-[rgb(var(--color-text-secondary))]">
                Potente librería de animaciones profesionales. Timeline y control total.
              </p>
              <code class="text-xs">npm install gsap</code>
            </div>
            
            <div>
              <h4 class="text-sm font-semibold mb-2">Motion One</h4>
              <p class="text-xs text-[rgb(var(--color-text-secondary))]">
                Alternativa ligera y moderna a GSAP. Funciona con Web Animations API.
              </p>
              <code class="text-xs">npm install motion</code>
            </div>
            
            <div>
              <h4 class="text-sm font-semibold mb-2">AOS (Animate On Scroll)</h4>
              <p class="text-xs text-[rgb(var(--color-text-secondary))]">
                Anima elementos al hacer scroll. Simple y efectivo.
              </p>
              <code class="text-xs">npm install aos</code>
            </div>
          </div>
        </div>

        <!-- Scroll -->
        <div class="card">
          <h3 class="font-semibold text-primary-600 dark:text-primary-400 mb-3">📜 Scroll Suave</h3>
          <div class="grid md:grid-cols-2 gap-4">
            <div>
              <h4 class="text-sm font-semibold mb-2">Lenis</h4>
              <p class="text-xs text-[rgb(var(--color-text-secondary))]">
                Smooth scroll moderno y performante. El más usado actualmente.
              </p>
              <code class="text-xs">npm install @studio-freight/lenis</code>
            </div>
            
            <div>
              <h4 class="text-sm font-semibold mb-2">Locomotive Scroll</h4>
              <p class="text-xs text-[rgb(var(--color-text-secondary))]">
                Scroll suave con parallax y efectos visuales incluidos.
              </p>
              <code class="text-xs">npm install locomotive-scroll</code>
            </div>
          </div>
        </div>

        <!-- UI Components -->
        <div class="card">
          <h3 class="font-semibold text-primary-600 dark:text-primary-400 mb-3">🧩 Componentes UI</h3>
          <div class="grid md:grid-cols-2 gap-4">
            <div>
              <h4 class="text-sm font-semibold mb-2">Swiper</h4>
              <p class="text-xs text-[rgb(var(--color-text-secondary))]">
                Carousels y sliders modernos, touch-friendly y responsivos.
              </p>
              <code class="text-xs">npm install swiper</code>
            </div>
            
            <div>
              <h4 class="text-sm font-semibold mb-2">Iconify</h4>
              <p class="text-xs text-[rgb(var(--color-text-secondary))]">
                +150,000 iconos de todas las librerías populares en un solo lugar.
              </p>
              <code class="text-xs">npm install @iconify/react</code>
            </div>
            
            <div>
              <h4 class="text-sm font-semibold mb-2">React Hook Form</h4>
              <p class="text-xs text-[rgb(var(--color-text-secondary))]">
                Manejo de formularios performante y con validación.
              </p>
              <code class="text-xs">npm install react-hook-form</code>
            </div>
            
            <div>
              <h4 class="text-sm font-semibold mb-2">Zod</h4>
              <p class="text-xs text-[rgb(var(--color-text-secondary))]">
                Validación de datos con TypeScript. Perfecto para formularios y APIs.
              </p>
              <code class="text-xs">npm install zod</code>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Recursos Gratuitos -->
    <section class="mb-16">
      <h2 class="flex items-center space-x-3">
        <Palette className="w-8 h-8 text-purple-600 dark:text-purple-400" />
        <span>Recursos Gratuitos</span>
      </h2>

      <div class="grid md:grid-cols-2 gap-6">
        <!-- Diseño -->
        <div class="card">
          <h3 class="font-semibold mb-3">🎨 Diseño & UI</h3>
          <ul class="space-y-2 text-sm">
            <li><a href="https://dribbble.com" target="_blank" class="text-primary-600 hover:underline">Dribbble</a> - Inspiración de diseño</li>
            <li><a href="https://www.behance.net" target="_blank" class="text-primary-600 hover:underline">Behance</a> - Portfolios creativos</li>
            <li><a href="https://www.figma.com" target="_blank" class="text-primary-600 hover:underline">Figma</a> - Diseño UI/UX</li>
            <li><a href="https://uiverse.io" target="_blank" class="text-primary-600 hover:underline">Uiverse</a> - Componentes UI</li>
          </ul>
        </div>

        <!-- Colores -->
        <div class="card">
          <h3 class="font-semibold mb-3">🎨 Colores</h3>
          <ul class="space-y-2 text-sm">
            <li><a href="https://coolors.co" target="_blank" class="text-primary-600 hover:underline">Coolors</a> - Generador de paletas</li>
            <li><a href="https://colorhunt.co" target="_blank" class="text-primary-600 hover:underline">Color Hunt</a> - Paletas populares</li>
            <li><a href="https://www.realtimecolors.com" target="_blank" class="text-primary-600 hover:underline">Realtime Colors</a> - Visualiza colores en vivo</li>
            <li><a href="https://uigradients.com" target="_blank" class="text-primary-600 hover:underline">UI Gradients</a> - Gradientes</li>
          </ul>
        </div>

        <!-- Tipografía -->
        <div class="card">
          <h3 class="font-semibold mb-3">✍️ Tipografía</h3>
          <ul class="space-y-2 text-sm">
            <li><a href="https://fonts.google.com" target="_blank" class="text-primary-600 hover:underline">Google Fonts</a> - Fuentes gratuitas</li>
            <li><a href="https://www.fontshare.com" target="_blank" class="text-primary-600 hover:underline">Fontshare</a> - Fuentes premium gratis</li>
            <li><a href="https://www.fontpair.co" target="_blank" class="text-primary-600 hover:underline">Font Pair</a> - Combinaciones de fuentes</li>
            <li><a href="https://typescale.com" target="_blank" class="text-primary-600 hover:underline">Type Scale</a> - Escalas tipográficas</li>
          </ul>
        </div>

        <!-- Imágenes -->
        <div class="card">
          <h3 class="font-semibold mb-3">📸 Imágenes</h3>
          <ul class="space-y-2 text-sm">
            <li><a href="https://unsplash.com" target="_blank" class="text-primary-600 hover:underline">Unsplash</a> - Fotos de alta calidad</li>
            <li><a href="https://www.pexels.com" target="_blank" class="text-primary-600 hover:underline">Pexels</a> - Fotos y videos gratis</li>
            <li><a href="https://pixabay.com" target="_blank" class="text-primary-600 hover:underline">Pixabay</a> - Imágenes libres</li>
            <li><a href="https://www.remove.bg" target="_blank" class="text-primary-600 hover:underline">Remove.bg</a> - Quitar fondo</li>
          </ul>
        </div>

        <!-- Iconos -->
        <div class="card">
          <h3 class="font-semibold mb-3">🎯 Iconos</h3>
          <ul class="space-y-2 text-sm">
            <li><a href="https://lucide.dev" target="_blank" class="text-primary-600 hover:underline">Lucide</a> - Iconos modernos (usado en este curso)</li>
            <li><a href="https://heroicons.com" target="_blank" class="text-primary-600 hover:underline">Heroicons</a> - De Tailwind Labs</li>
            <li><a href="https://fontawesome.com" target="_blank" class="text-primary-600 hover:underline">Font Awesome</a> - Clásico</li>
            <li><a href="https://tabler-icons.io" target="_blank" class="text-primary-600 hover:underline">Tabler Icons</a> - +4500 iconos</li>
          </ul>
        </div>

        <!-- Herramientas -->
        <div class="card">
          <h3 class="font-semibold mb-3">🛠️ Herramientas</h3>
          <ul class="space-y-2 text-sm">
            <li><a href="https://www.photopea.com" target="_blank" class="text-primary-600 hover:underline">Photopea</a> - Photoshop online</li>
            <li><a href="https://squoosh.app" target="_blank" class="text-primary-600 hover:underline">Squoosh</a> - Optimizar imágenes</li>
            <li><a href="https://tinypng.com" target="_blank" class="text-primary-600 hover:underline">TinyPNG</a> - Comprimir imágenes</li>
            <li><a href="https://transform.tools" target="_blank" class="text-primary-600 hover:underline">Transform Tools</a> - Convertir código</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Cheat Sheets -->
    <section class="mb-16">
      <h2 class="flex items-center space-x-3">
        <BookOpen className="w-8 h-8 text-purple-600 dark:text-purple-400" />
        <span>Cheat Sheets (Hojas de Referencia Rápida)</span>
      </h2>

      <p class="mb-6">Guías rápidas de consulta con los comandos y sintaxis más importantes:</p>

      <!-- HTML Cheat Sheet -->
      <div class="card mb-6">
        <h3 class="text-xl font-semibold mb-4 flex items-center gap-2">
          <span class="text-2xl">📄</span>
          HTML Cheat Sheet
        </h3>
        
        <div class="space-y-4">
          <div>
            <h4 class="font-semibold text-orange-600 mb-2">Estructura Básica</h4>
            <div class="bg-gray-50 dark:bg-gray-800 p-3 rounded font-mono text-xs overflow-x-auto">
              <pre>&lt;!DOCTYPE html&gt;
&lt;html lang="es"&gt;
  &lt;head&gt;
    &lt;meta charset="UTF-8"&gt;
    &lt;title&gt;Título&lt;/title&gt;
  &lt;/head&gt;
  &lt;body&gt;
    &lt;!-- Contenido aquí --&gt;
  &lt;/body&gt;
&lt;/html&gt;</pre>
            </div>
          </div>

          <div class="grid md:grid-cols-2 gap-4">
            <div>
              <h4 class="font-semibold text-orange-600 mb-2">Textos</h4>
              <div class="bg-gray-50 dark:bg-gray-800 p-3 rounded text-xs space-y-1">
                <p><code>&lt;h1&gt; a &lt;h6&gt;</code> - Títulos</p>
                <p><code>&lt;p&gt;</code> - Párrafo</p>
                <p><code>&lt;strong&gt;</code> - Negrita</p>
                <p><code>&lt;em&gt;</code> - Cursiva</p>
                <p><code>&lt;br&gt;</code> - Salto de línea</p>
                <p><code>&lt;hr&gt;</code> - Línea horizontal</p>
              </div>
            </div>

            <div>
              <h4 class="font-semibold text-orange-600 mb-2">Enlaces e Imágenes</h4>
              <div class="bg-gray-50 dark:bg-gray-800 p-3 rounded text-xs space-y-1">
                <p><code>&lt;a href="url"&gt;Texto&lt;/a&gt;</code></p>
                <p><code>&lt;img src="imagen.jpg" alt="descripción"&gt;</code></p>
                <p><code>target="_blank"</code> - Abrir en nueva pestaña</p>
              </div>
            </div>

            <div>
              <h4 class="font-semibold text-orange-600 mb-2">Listas</h4>
              <div class="bg-gray-50 dark:bg-gray-800 p-3 rounded text-xs space-y-1">
                <p><code>&lt;ul&gt;&lt;li&gt;</code> - Lista desordenada</p>
                <p><code>&lt;ol&gt;&lt;li&gt;</code> - Lista ordenada</p>
                <p><code>&lt;dl&gt;&lt;dt&gt;&lt;dd&gt;</code> - Lista definición</p>
              </div>
            </div>

            <div>
              <h4 class="font-semibold text-orange-600 mb-2">Tablas</h4>
              <div class="bg-gray-50 dark:bg-gray-800 p-3 rounded text-xs space-y-1">
                <p><code>&lt;table&gt;</code> - Tabla</p>
                <p><code>&lt;thead&gt;, &lt;tbody&gt;, &lt;tfoot&gt;</code></p>
                <p><code>&lt;tr&gt;</code> - Fila</p>
                <p><code>&lt;th&gt;</code> - Encabezado</p>
                <p><code>&lt;td&gt;</code> - Celda</p>
              </div>
            </div>
          </div>

          <div>
            <h4 class="font-semibold text-orange-600 mb-2">Formularios</h4>
            <div class="bg-gray-50 dark:bg-gray-800 p-3 rounded text-xs space-y-2">
              <p><code>&lt;form action="url" method="POST"&gt;</code></p>
              <div class="grid md:grid-cols-2 gap-2 ml-4">
                <p><code>&lt;input type="text"&gt;</code></p>
                <p><code>&lt;input type="email"&gt;</code></p>
                <p><code>&lt;input type="password"&gt;</code></p>
                <p><code>&lt;input type="checkbox"&gt;</code></p>
                <p><code>&lt;input type="radio"&gt;</code></p>
                <p><code>&lt;input type="file"&gt;</code></p>
                <p><code>&lt;textarea&gt;</code></p>
                <p><code>&lt;select&gt;&lt;option&gt;</code></p>
                <p><code>&lt;button type="submit"&gt;</code></p>
              </div>
              <p><code>required</code> - Campo obligatorio</p>
              <p><code>&lt;label for="id"&gt;</code> - Etiqueta</p>
            </div>
          </div>

          <div>
            <h4 class="font-semibold text-orange-600 mb-2">HTML Semántico</h4>
            <div class="bg-gray-50 dark:bg-gray-800 p-3 rounded text-xs">
              <div class="grid md:grid-cols-3 gap-2">
                <p><code>&lt;header&gt;</code> - Encabezado</p>
                <p><code>&lt;nav&gt;</code> - Navegación</p>
                <p><code>&lt;main&gt;</code> - Contenido principal</p>
                <p><code>&lt;section&gt;</code> - Sección</p>
                <p><code>&lt;article&gt;</code> - Artículo</p>
                <p><code>&lt;aside&gt;</code> - Contenido lateral</p>
                <p><code>&lt;footer&gt;</code> - Pie de página</p>
                <p><code>&lt;figure&gt;</code> - Figura</p>
                <p><code>&lt;figcaption&gt;</code> - Pie de figura</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- CSS Cheat Sheet -->
      <div class="card mb-6">
        <h3 class="text-xl font-semibold mb-4 flex items-center gap-2">
          <span class="text-2xl">🎨</span>
          CSS Cheat Sheet
        </h3>
        
        <div class="space-y-4">
          <div class="grid md:grid-cols-2 gap-4">
            <div>
              <h4 class="font-semibold text-primary-600 mb-2">Selectores</h4>
              <div class="bg-gray-50 dark:bg-gray-800 p-3 rounded text-xs space-y-1">
                <p><code>elemento {'{}'}</code> - Por etiqueta</p>
                <p><code>.clase {'{}'}</code> - Por clase</p>
                <p><code>#id {'{}'}</code> - Por ID</p>
                <p><code>* {'{}'}</code> - Universal</p>
                <p><code>padre hijo {'{}'}</code> - Descendiente</p>
                <p><code>elemento:hover {'{}'}</code> - Pseudo-clase</p>
              </div>
            </div>

            <div>
              <h4 class="font-semibold text-primary-600 mb-2">Colores</h4>
              <div class="bg-gray-50 dark:bg-gray-800 p-3 rounded text-xs space-y-1">
                <p><code>color: red;</code></p>
                <p><code>color: #ff0000;</code> - Hexadecimal</p>
                <p><code>color: rgb(255, 0, 0);</code></p>
                <p><code>color: rgba(255, 0, 0, 0.5);</code></p>
                <p><code>background-color: blue;</code></p>
              </div>
            </div>

            <div>
              <h4 class="font-semibold text-primary-600 mb-2">Texto</h4>
              <div class="bg-gray-50 dark:bg-gray-800 p-3 rounded text-xs space-y-1">
                <p><code>font-size: 16px;</code></p>
                <p><code>font-family: Arial, sans-serif;</code></p>
                <p><code>font-weight: bold;</code> (400-900)</p>
                <p><code>text-align: center;</code></p>
                <p><code>line-height: 1.5;</code></p>
                <p><code>text-decoration: underline;</code></p>
              </div>
            </div>

            <div>
              <h4 class="font-semibold text-primary-600 mb-2">Box Model</h4>
              <div class="bg-gray-50 dark:bg-gray-800 p-3 rounded text-xs space-y-1">
                <p><code>width: 200px;</code></p>
                <p><code>height: 100px;</code></p>
                <p><code>margin: 10px;</code> - Exterior</p>
                <p><code>padding: 10px;</code> - Interior</p>
                <p><code>border: 1px solid black;</code></p>
                <p><code>box-sizing: border-box;</code></p>
              </div>
            </div>
