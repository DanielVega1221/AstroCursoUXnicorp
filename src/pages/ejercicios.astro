---
import CourseLayout from '../layouts/CourseLayout.astro';
import { CheckSquare, Code, Palette, Zap, Rocket } from 'lucide-react';
---

<CourseLayout title="Ejercicios Prácticos | UXnicorp Academy">
  <div class="prose-custom max-w-4xl">
    <div class="mb-12 animate-slide-up">
      <div class="flex items-center space-x-3 mb-4">
        <div class="w-12 h-12 rounded-xl bg-green-500/10 flex items-center justify-center">
          <CheckSquare className="w-6 h-6 text-green-600 dark:text-green-400" />
        </div>
        <div>
          <h1 class="text-4xl font-bold m-0">Ejercicios Prácticos</h1>
        </div>
      </div>
      <p class="text-xl text-[rgb(var(--color-text-secondary))]">
        Practica lo aprendido con ejercicios organizados por módulo. Autocorregibles y con soluciones incluidas.
      </p>
    </div>

    <!-- HTML Exercises -->
    <section class="mb-16">
      <h2 class="flex items-center space-x-3">
        <Code className="w-8 h-8 text-orange-600 dark:text-orange-400" />
        <span>Ejercicios HTML</span>
      </h2>

      <div class="space-y-4">
        <div class="card hover:scale-102 transition-transform cursor-pointer">
          <div class="flex items-start justify-between">
            <div class="flex-1">
              <h3 class="text-lg font-semibold mb-2">1. Crear una Página de Perfil</h3>
              <p class="text-sm text-[rgb(var(--color-text-secondary))]">
                Crea una página HTML con tu perfil personal: foto, nombre, descripción, lista de habilidades y enlaces a redes sociales.
              </p>
              <div class="flex items-center space-x-4 mt-3">
                <span class="text-xs px-2 py-1 rounded bg-orange-500/10 text-orange-600">Básico</span>
                <span class="text-xs text-[rgb(var(--color-text-secondary))]">⏱️ 20 min</span>
              </div>
            </div>
          </div>
        </div>

        <div class="card hover:scale-102 transition-transform cursor-pointer">
          <div class="flex items-start justify-between">
            <div class="flex-1">
              <h3 class="text-lg font-semibold mb-2">2. Formulario de Contacto Completo</h3>
              <p class="text-sm text-[rgb(var(--color-text-secondary))]">
                Construye un formulario con: nombre, email, asunto (select), mensaje (textarea), checkbox de términos y botón de envío.
              </p>
              <div class="flex items-center space-x-4 mt-3">
                <span class="text-xs px-2 py-1 rounded bg-orange-500/10 text-orange-600">Intermedio</span>
                <span class="text-xs text-[rgb(var(--color-text-secondary))]">⏱️ 30 min</span>
              </div>
            </div>
          </div>
        </div>

        <div class="card hover:scale-102 transition-transform cursor-pointer">
          <div class="flex items-start justify-between">
            <div class="flex-1">
              <h3 class="text-lg font-semibold mb-2">3. Estructura Semántica de Blog</h3>
              <p class="text-sm text-[rgb(var(--color-text-secondary))]">
                Crea la estructura HTML de un blog usando etiquetas semánticas: header, nav, main, article, aside, footer.
              </p>
              <div class="flex items-center space-x-4 mt-3">
                <span class="text-xs px-2 py-1 rounded bg-primary-500/10 text-primary-600">Avanzado</span>
                <span class="text-xs text-[rgb(var(--color-text-secondary))]">⏱️ 40 min</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CSS Exercises -->
    <section class="mb-16">
      <h2 class="flex items-center space-x-3">
        <Palette className="w-8 h-8 text-primary-600 dark:text-primary-400" />
        <span>Ejercicios CSS</span>
      </h2>

      <div class="space-y-4">
        <div class="card hover:scale-102 transition-transform cursor-pointer">
          <h3 class="text-lg font-semibold mb-2">4. Card Component</h3>
          <p class="text-sm text-[rgb(var(--color-text-secondary))]">
            Crea una card con imagen, título, descripción y botón. Debe tener hover effect, sombras y border-radius.
          </p>
          <div class="flex items-center space-x-4 mt-3">
            <span class="text-xs px-2 py-1 rounded bg-primary-500/10 text-primary-600">Básico</span>
            <span class="text-xs text-[rgb(var(--color-text-secondary))]">⏱️ 25 min</span>
          </div>
        </div>

        <div class="card hover:scale-102 transition-transform cursor-pointer">
          <h3 class="text-lg font-semibold mb-2">5. Navbar Responsive con Flexbox</h3>
          <p class="text-sm text-[rgb(var(--color-text-secondary))]">
            Construye un navbar que en desktop muestre links horizontales y en móvil se convierta en menú hamburguesa.
          </p>
          <div class="flex items-center space-x-4 mt-3">
            <span class="text-xs px-2 py-1 rounded bg-orange-500/10 text-orange-600">Intermedio</span>
            <span class="text-xs text-[rgb(var(--color-text-secondary))]">⏱️ 45 min</span>
          </div>
        </div>

        <div class="card hover:scale-102 transition-transform cursor-pointer">
          <h3 class="text-lg font-semibold mb-2">6. Galería con CSS Grid</h3>
          <p class="text-sm text-[rgb(var(--color-text-secondary))]">
            Crea una galería de imágenes responsive usando CSS Grid. Debe adaptarse automáticamente al tamaño de pantalla.
          </p>
          <div class="flex items-center space-x-4 mt-3">
            <span class="text-xs px-2 py-1 rounded bg-blue-500/10 text-blue-600">Avanzado</span>
            <span class="text-xs text-[rgb(var(--color-text-secondary))]">⏱️ 50 min</span>
          </div>
        </div>

        <div class="card hover:scale-102 transition-transform cursor-pointer">
          <h3 class="text-lg font-semibold mb-2">7. Dark Mode Toggle</h3>
          <p class="text-sm text-[rgb(var(--color-text-secondary))]">
            Implementa un sistema de dark mode usando CSS variables y localStorage para persistir la preferencia.
          </p>
          <div class="flex items-center space-x-4 mt-3">
            <span class="text-xs px-2 py-1 rounded bg-purple-500/10 text-purple-600">Avanzado</span>
            <span class="text-xs text-[rgb(var(--color-text-secondary))]">⏱️ 60 min</span>
          </div>
        </div>
      </div>
    </section>

    <!-- JavaScript Exercises -->
    <section class="mb-16">
      <h2 class="flex items-center space-x-3">
        <Zap className="w-8 h-8 text-yellow-600 dark:text-yellow-400" />
        <span>Ejercicios JavaScript</span>
      </h2>

      <div class="space-y-4">
        <div class="card hover:scale-102 transition-transform cursor-pointer">
          <h3 class="text-lg font-semibold mb-2">8. Calculadora Simple</h3>
          <p class="text-sm text-[rgb(var(--color-text-secondary))]">
            Crea una calculadora que realice operaciones básicas: suma, resta, multiplicación y división.
          </p>
          <div class="flex items-center space-x-4 mt-3">
            <span class="text-xs px-2 py-1 rounded bg-yellow-500/10 text-yellow-600">Básico</span>
            <span class="text-xs text-[rgb(var(--color-text-secondary))]">⏱️ 30 min</span>
          </div>
        </div>

        <div class="card hover:scale-102 transition-transform cursor-pointer">
          <h3 class="text-lg font-semibold mb-2">9. To-Do List App</h3>
          <p class="text-sm text-[rgb(var(--color-text-secondary))]">
            App de tareas con agregar, marcar como completada, eliminar y guardar en localStorage.
          </p>
          <div class="flex items-center space-x-4 mt-3">
            <span class="text-xs px-2 py-1 rounded bg-orange-500/10 text-orange-600">Intermedio</span>
            <span class="text-xs text-[rgb(var(--color-text-secondary))]">⏱️ 60 min</span>
          </div>
        </div>

        <div class="card hover:scale-102 transition-transform cursor-pointer">
          <h3 class="text-lg font-semibold mb-2">10. Buscador con Filtros</h3>
          <p class="text-sm text-[rgb(var(--color-text-secondary))]">
            Crea un buscador que filtre una lista de items en tiempo real según el texto ingresado.
          </p>
          <div class="flex items-center space-x-4 mt-3">
            <span class="text-xs px-2 py-1 rounded bg-yellow-500/10 text-yellow-600">Intermedio</span>
            <span class="text-xs text-[rgb(var(--color-text-secondary))]">⏱️ 45 min</span>
          </div>
        </div>

        <div class="card hover:scale-102 transition-transform cursor-pointer">
          <h3 class="text-lg font-semibold mb-2">11. Weather App con API</h3>
          <p class="text-sm text-[rgb(var(--color-text-secondary))]">
            Consume la API de OpenWeatherMap para mostrar el clima de una ciudad. Practica fetch y async/await.
          </p>
          <div class="flex items-center space-x-4 mt-3">
            <span class="text-xs px-2 py-1 rounded bg-blue-500/10 text-blue-600">Avanzado</span>
            <span class="text-xs text-[rgb(var(--color-text-secondary))]">⏱️ 90 min</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Astro Exercises -->
    <section class="mb-16">
      <h2 class="flex items-center space-x-3">
        <Rocket className="w-8 h-8 text-orange-600 dark:text-orange-400" />
        <span>Ejercicios Astro</span>
      </h2>

      <div class="space-y-4">
        <div class="card hover:scale-102 transition-transform cursor-pointer">
          <h3 class="text-lg font-semibold mb-2">12. Blog Personal con Astro</h3>
          <p class="text-sm text-[rgb(var(--color-text-secondary))]">
            Crea un blog usando Content Collections, con listado de posts, página individual y categorías.
          </p>
          <div class="flex items-center space-x-4 mt-3">
            <span class="text-xs px-2 py-1 rounded bg-orange-500/10 text-orange-600">Intermedio</span>
            <span class="text-xs text-[rgb(var(--color-text-secondary))]">⏱️ 120 min</span>
          </div>
        </div>

        <div class="card hover:scale-102 transition-transform cursor-pointer">
          <h3 class="text-lg font-semibold mb-2">13. Landing Page con React Islands</h3>
          <p class="text-sm text-[rgb(var(--color-text-secondary))]">
            Construye una landing page en Astro con componentes React interactivos (contador, formulario, carousel).
          </p>
          <div class="flex items-center space-x-4 mt-3">
            <span class="text-xs px-2 py-1 rounded bg-blue-500/10 text-blue-600">Avanzado</span>
            <span class="text-xs text-[rgb(var(--color-text-secondary))]">⏱️ 150 min</span>
          </div>
        </div>

        <div class="card hover:scale-102 transition-transform cursor-pointer">
          <h3 class="text-lg font-semibold mb-2">14. Portfolio con TypeScript</h3>
          <p class="text-sm text-[rgb(var(--color-text-secondary))]">
            Crea tu portfolio en Astro + TypeScript con secciones: sobre mí, proyectos, habilidades, contacto.
          </p>
          <div class="flex items-center space-x-4 mt-3">
            <span class="text-xs px-2 py-1 rounded bg-purple-500/10 text-purple-600">Avanzado</span>
            <span class="text-xs text-[rgb(var(--color-text-secondary))]">⏱️ 180 min</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Tips -->
    <section class="mb-16">
      <h2>💡 Consejos para los Ejercicios</h2>

      <div class="grid md:grid-cols-2 gap-4">
        <div class="card bg-green-500/5 border-l-4 border-green-500">
          <h4 class="text-green-600 dark:text-green-400 font-semibold">Intenta primero solo</h4>
          <p class="text-sm">No veas la solución de inmediato. El error es parte del aprendizaje.</p>
        </div>

        <div class="card bg-primary-500/5 border-l-4 border-primary-500">
          <h4 class="text-primary-600 dark:text-primary-400 font-semibold">Usa la consola</h4>
          <p class="text-sm">F12 en el navegador te mostrará errores y permitirá debuggear.</p>
        </div>

        <div class="card bg-purple-500/5 border-l-4 border-purple-500">
          <h4 class="text-purple-600 dark:text-purple-400 font-semibold">Investiga</h4>
          <p class="text-sm">Si te atascas, busca en MDN, Stack Overflow o pregunta a la comunidad.</p>
        </div>

        <div class="card bg-orange-500/5 border-l-4 border-orange-500">
          <h4 class="text-orange-600 dark:text-orange-400 font-semibold">Experimenta</h4>
          <p class="text-sm">Modifica los ejercicios, añade funcionalidades extra, hazlos tuyos.</p>
        </div>
      </div>
    </section>

    <!-- Navigation -->
    <div class="flex justify-between items-center pt-8 border-t border-[rgb(var(--color-border))]">
      <a href="/curso/metodologias" class="btn btn-secondary">
        ← Metodologías
      </a>
      <a href="/proyecto-final" class="btn btn-primary">
        Siguiente: Proyecto Final →
      </a>
    </div>
  </div>
</CourseLayout>
